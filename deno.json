{
  "tasks": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read=. --allow-write=./data src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net",
    "check": "deno fmt --check && deno lint && deno check src/ test/"
  },
  "imports": {
    "@nhttp/nhttp": "jsr:@nhttp/nhttp@^2.0.3",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@0.225.0",
    "@std/testing/mock": "jsr:@std/testing@1/mock"
  },
  "fmt": {
    "exclude": [".cache/"]
  },
  "lint": {
    "exclude": [".cache/"]
  }
}
