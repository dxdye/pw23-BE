# Comma-separated GitHub accounts to cache
GITHUB_ACCOUNTS=dxdye,d2tsb

# Where the SQLite cache file lives
CACHE_DB_PATH=./data/cache.db

# How often the cache is refreshed, in milliseconds (default: 5 minutes)
CACHE_REFRESH_INTERVAL_MS=300000

# How long a cached entry counts as fresh (default: 2x the refresh interval)
# CACHE_TTL_MS=600000

# Allowed CORS origins, comma-separated. "*" allows every origin.
CORS_ORIGINS=*

# Optional GitHub token: raises the rate limit from 60 to 5000 requests/hour
# GITHUB_TOKEN=your_token_here

# App port
PORT=8000
